FROM python:3.14-slim

WORKDIR /app

# Create a fresh venv and install streamlit dependencies
RUN python -m venv /app/.venv && \
    /app/.venv/bin/pip install --no-cache-dir streamlit requests pandas

ENV VIRTUAL_ENV=/app/.venv
ENV PATH=/app/.venv/bin:$PATH

COPY dashboard.py .

EXPOSE 8501

CMD ["streamlit", "run", "dashboard.py", "--server.port=8501", "--server.address=0.0.0.0", "--logger.level=error"]
